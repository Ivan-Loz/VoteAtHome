@model VotingClient.Models.Vote

@{ ViewBag.Title = "Редактирование кандидата"; }

<h2>Редактирование кандидата</h2>

@using (Html.BeginForm())
{
@Html.HiddenFor(model => model.Id)

<div class="form-group">
     <label>ФОИ</label>

@Html.TextBoxFor(model => model.FullName,
new
    {
       @class = "form-control"
    })
</div>

<div class="form-group">
     <label>Возраст</label>

     @Html.TextBoxFor(
     model => model.Age,
     new
           {
              @class = "form-control",
              type = "number"
           })
</div>

<div class="form-group">
     <label>Описание</label>

      @Html.TextBoxFor(
      model => model.Description,
      new
            {
               @class = "form-control",
            })
</div>

<div class="form-group">
     <label>Категория</label>

     @Html.TextBoxFor(
     model => model.Category,
     new
           {
               @class = "form-control"
           })
</div>
<div class="form-group">
    <label>Фото</label>

    @Html.TextBoxFor(
         model => model.photo,
         new
         {
             @class = "form-control"
         })
</div>

<br />

<button type="submit"class="btn btn-primary">Сохранить</button>

<a href="@Url.Action(
                "Vote",
                "GlobalVote")"
class="btn btn-default">
        Отмена
</a>}

@if (ViewBag.Message != null)
{
<p>
    @ViewBag.Message
</p>}